{
  "name": "agentguard",
  "version": "0.1.0",
  "description": "Evaluation workspace for tool-using AI agents",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "emulators": "firebase emulators:start --project demo-agentguard-local --only auth,firestore",
    "lint": "eslint",
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "test:rules": "firebase emulators:exec --project demo-agentguard-local --only firestore \"node --experimental-strip-types --test tests/firestore-rules.test.mjs\"",
    "eval:benchmark": "node --experimental-strip-types scripts/evaluate-benchmark.mjs",
    "eval:gate": "node --experimental-strip-types scripts/evaluate-benchmark.mjs --gate"
  },
  "dependencies": {
    "@google/genai": "^2.18.0",
    "firebase": "^12.18.0",
    "firebase-admin": "^13.10.0",
    "lucide-react": "^1.33.0",
    "next": "^16.4.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "recharts": "^3.10.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "^16.4.0",
    "firebase-tools": "^15.33.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "overrides": {
    "@grpc/grpc-js": "^1.14.6",
    "source-map-js": "^1.2.2",
    "firebase-admin": {
      "uuid": "11.1.1"
    },
    "@google-cloud/storage": {
      "gaxios": {
        "uuid": "11.1.1"
      }
    }
  },
  "engines": {
    "node": "22.x"
  }
}
