# Local-only Firebase Emulator Suite configuration. These are demo values.
NEXT_PUBLIC_FIREBASE_API_KEY=demo-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=localhost
NEXT_PUBLIC_FIREBASE_PROJECT_ID=demo-agentguard-local
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=demo-agentguard-local.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=123456789
NEXT_PUBLIC_FIREBASE_APP_ID=1:123456789:web:agentguard-local
NEXT_PUBLIC_AGENTGUARD_FIREBASE_EMULATORS=1

FIREBASE_PROJECT_ID=demo-agentguard-local
AGENTGUARD_FIREBASE_EMULATORS=1
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
FIRESTORE_EMULATOR_HOST=127.0.0.1:8180

# Set only when you intentionally run a live Gemini evaluation.
# GEMINI_API_KEY=
